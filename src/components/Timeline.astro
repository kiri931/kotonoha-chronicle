---
import Portrait from './Portrait.astro';
interface Props { groups: { era: any; people: any[] }[] }
const { groups } = Astro.props;
---
<div class="timeline-scroll -mx-4 overflow-x-auto px-4 pb-4">
  <ol class="flex min-w-max items-stretch gap-4">
    {groups.map(({ era, people }) => (
      <li
        class="w-64 shrink-0 rounded-lg border p-4"
        style="border-color: var(--rule); background: var(--paper-raised);"
      >
        <p class="text-xs" style="color: var(--ink-muted);">{era.rangeLabel}</p>
        <h3 class="font-serif text-base font-bold">
          <a href={`/eras/${era.id}/`} class="no-underline hover:underline" style="color: var(--ink);">{era.name}</a>
        </h3>
        <ul class="mt-3 space-y-2">
          {people.slice(0, 3).map((p) => (
            <li class="flex items-center gap-2">
              <Portrait person={p} size={40} class="shrink-0 rounded-full" />
              <a href={`/people/${p.data.id}/`} class="text-sm no-underline hover:underline" style="color: var(--ink);">
                {p.data.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs">
          <a href={`/eras/${era.id}/`} style="color: var(--ink-muted);">この年代の{people.length}人を見る →</a>
        </p>
      </li>
    ))}
  </ol>
</div>
