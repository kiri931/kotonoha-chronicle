---
import ConfidenceBadge from './ConfidenceBadge.astro';
import Ruby from './Ruby.astro';
import { findTerms } from '../data/glossary';

interface Props {
  quote: any;
  vertical?: boolean;
  /** その人物だけに効かせるふりがなの上書き */
  overrides?: Record<string, string>;
  /** ことばの解説を出すか（一覧では出さない） */
  showTerms?: boolean;
}
const { quote, vertical = false, overrides, showTerms = true } = Astro.props;
const terms = showTerms ? findTerms(`${quote.text} ${quote.reading ?? ''}`) : [];
---
<figure class="rounded-lg border p-5 sm:p-6" style="border-color: var(--rule); background: var(--paper-raised);">
  <div class={vertical ? 'lg:flex lg:justify-center' : ''}>
    <blockquote
      class={`font-serif text-xl leading-relaxed sm:text-2xl ${vertical ? 'vertical-quote' : ''}`}
      style="color: var(--ink);"
    >
      <Ruby text={quote.text} overrides={overrides} />
    </blockquote>
  </div>
  {quote.reading && (
    <p class="mt-4 text-sm" style="color: var(--ink-muted);">
      <span class="font-bold">読み・現代語：</span><Ruby text={quote.reading} overrides={overrides} />
    </p>
  )}
  <figcaption class="mt-4 border-t pt-4 text-sm leading-relaxed" style="border-color: var(--rule);">
    <p><Ruby text={quote.meaning} overrides={overrides} /></p>
    {terms.length > 0 && (
      <div class="mt-4 rounded border p-3" style="border-color: var(--rule); background: var(--paper);">
        <p class="mb-2 text-xs font-bold" style="color: var(--ink-muted);">ことばの意味</p>
        <dl class="space-y-1.5">
          {terms.map((t) => (
            <div class="text-sm">
              <dt class="inline font-bold">
                <ruby>{t.word}<rp>（</rp><rt>{t.reading}</rt><rp>）</rp></ruby>
              </dt>
              <dd class="inline">：{t.note}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
    <p class="mt-3 flex flex-wrap items-center gap-2 text-xs" style="color: var(--ink-muted);">
      <span>出典：<Ruby text={quote.source} /></span>
      <ConfidenceBadge confidence={quote.confidence} />
    </p>
  </figcaption>
</figure>
