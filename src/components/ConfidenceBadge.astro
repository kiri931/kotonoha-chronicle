---
interface Props { confidence: '確実' | '諸説あり' | '伝承' }
const { confidence } = Astro.props;
const note: Record<string, string> = {
  確実: '本人の著作や記録で確認できる言葉です',
  諸説あり: '本人の言葉とされますが、表現や場面に諸説あります',
  伝承: '後世に語り伝えられてきた言葉で、本人の発言とは確認できていません',
};
const mark: Record<string, string> = { 確実: '◎', 諸説あり: '△', 伝承: '＊' };
---
<span
  class="inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs"
  style="border-color: var(--control-border); color: var(--ink); background: var(--paper);"
  title={note[confidence]}
>
  <span aria-hidden="true">{mark[confidence]}</span>
  <span>出典の確度：{confidence}</span>
  <span class="sr-only">。{note[confidence]}</span>
</span>
