---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { link } from '../../lib/url';
import PersonCard from '../../components/PersonCard.astro';
import { eras } from '../../data/eras';
import { allPeople } from '../../lib/people';

export async function getStaticPaths() {
  const people = await allPeople();
  return eras.map((era) => ({
    params: { eraId: era.id },
    props: { era, people: people.filter((p) => p.data.eraId === era.id) },
  }));
}

const { era, people } = Astro.props;
---
<BaseLayout
  title={era.name}
  description={`${era.name}（${era.rangeLabel}）の人物と名言。${era.lead}`}
>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <nav aria-label="パンくず" class="mb-4 text-sm" style="color: var(--ink-muted);">
      <a href={link('/')} style="color: var(--ink-muted);">ホーム</a> ／ 年代
    </nav>
    <p class="text-sm tracking-wide" style="color: var(--ink-muted);">{era.rangeLabel}</p>
    <h1 class="font-serif text-3xl font-bold sm:text-4xl">{era.name}</h1>
    <p class="mt-4 max-w-2xl font-serif leading-loose">{era.lead}</p>

    {people.length === 0 ? (
      <p class="mt-10">この年代の人物はまだ収録していません。</p>
    ) : (
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {people.map((p) => (<li><PersonCard person={p} /></li>))}
      </ul>
    )}

    <h2 class="mt-12 font-serif text-xl font-bold">ほかの年代</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {eras.filter((e) => e.id !== era.id).map((e) => (
        <li>
          <a href={link(`/eras/${e.id}/`)} class="inline-block rounded-full border px-3 py-1 text-sm no-underline"
             style="border-color: var(--control-border); color: var(--ink); background: var(--paper-raised);">
            {e.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
